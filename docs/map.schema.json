{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wandering Atlas map",
  "type": "object",
  "required": [
    "id",
    "name",
    "subtitle",
    "description",
    "image",
    "thumbnail",
    "width",
    "height",
    "theme",
    "region",
    "locations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "thumbnail": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "credit": {
      "type": "string",
      "minLength": 1
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "districts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "initialView": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "x",
          "y",
          "district",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "person": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "rumor": {
            "type": "string"
          },
          "category": {
            "enum": [
              "landmark",
              "tavern",
              "shop",
              "workshop",
              "temple",
              "guild",
              "harbor",
              "home"
            ]
          },
          "x": {
            "type": "number",
            "minimum": 0
          },
          "y": {
            "type": "number",
            "minimum": 0
          },
          "bounds": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "number",
                "exclusiveMinimum": 0
              }
            ]
          },
          "featured": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
